{
  "name": "vantis-media-player-monorepo",
  "version": "1.6.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write &quot;**/*.{ts,tsx,md,json}&quot;",
    "cargo:build": "cargo build --release --all-features",
    "cargo:test": "cargo test --all",
    "cargo:lint": "cargo clippy --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}