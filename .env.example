# Vantis Media Player - Environment Configuration
# Copy this file to .env and configure the values

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
APP_NAME=Vantis Media Player
APP_VERSION=2.0.0
APP_PORT=3000

# ============================================
# API Configuration
# ============================================
API_URL=https://api.vantis.media
API_TIMEOUT=30000
API_RATE_LIMIT=100

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/vantis
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PREFIX=vantis:

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# GPG Signing (Post-Quantum Ready)
GPG_KEY_ID=your-key-id
GPG_PASSPHRASE=your-passphrase

# Zero Trust Security
ZERO_TRUST_ENABLED=true
ZERO_TRUST_API_KEY=your-zero-trust-api-key

# ============================================
# Web3 & Blockchain Configuration
# ============================================
WEB3_ENABLED=true
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
ETHEREUM_CONTRACT_ADDRESS=0x...
WALLET_CONNECT_PROJECT_ID=your-project-id

# ============================================
# AI & Machine Learning Configuration
# ============================================
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ============================================
# Streaming Configuration
# ============================================
STREAMING_SERVER_URL=rtmp://streaming.vantis.media/live
STREAMING_HLS_URL=https://streaming.vantis.media/hls
STREAMING_DASH_URL=https://streaming.vantis.media/dash

# ============================================
# Analytics & Telemetry
# ============================================
SENTRY_DSN=https://xxx@sentry.io/xxx
ANALYTICS_ENABLED=true
ANALYTICS_API_KEY=your-analytics-api-key
TELEMETRY_ENABLED=true

# ============================================
# CDN Configuration
# ============================================
CDN_URL=https://cdn.vantis.media
CDN_ENABLED=true
CDN_CACHE_DURATION=3600

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@vantis.media

# ============================================
# Storage Configuration
# ============================================
STORAGE_TYPE=local
STORAGE_PATH=/var/lib/vantis/storage
S3_BUCKET=vantis-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# Social Media Configuration
# ============================================
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# ============================================
# Payment Configuration
# ============================================
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ============================================
# CI/CD Configuration
# ============================================
CI_CD_ENABLED=true
CI_CD_WEBHOOK_SECRET=your-webhook-secret
DEPLOY_ENVIRONMENT=production

# ============================================
# Development Configuration
# ============================================
DEBUG=true
LOG_LEVEL=debug
HOT_RELOAD=true
SOURCE_MAPS=true

# ============================================
# Feature Flags
# ============================================
FEATURE_DARK_MODE=true
FEATURE_I18N=true
FEATURE_THEMES=true
FEATURE_PLUGINS=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_LIVE_STREAMING=true
FEATURE_SOCIAL_SHARING=true

# ============================================
# Performance Configuration
# ============================================
CACHE_ENABLED=true
CACHE_TTL=3600
COMPRESSION_ENABLED=true
MINIFICATION_ENABLED=true
LAZY_LOADING_ENABLED=true

# ============================================
# Accessibility Configuration
# ============================================
WCAG_LEVEL=AA
HIGH_CONTRAST_MODE=false
SCREEN_READER_SUPPORT=true

# ============================================
# Localization Configuration
# ============================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,pl,de,zh,ru,ko,es,fr
TIMEZONE=UTC

# ============================================
# Logging Configuration
# ============================================
LOG_FILE_PATH=/var/log/vantis/app.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=10
LOG_RETENTION_DAYS=30