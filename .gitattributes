# Vantis Media Player - Git Attributes

# ============================================
# Auto-detect text files and normalize line endings
# ============================================
* text=auto eol=lf

# ============================================
# Source code files
# ============================================
*.rs text eol=lf diff=rust
*.js text eol=lf diff=javascript
*.ts text eol=lf diff=typescript
*.tsx text eol=lf diff=typescript
*.jsx text eol=lf diff=javascript
*.py text eol=lf diff=python
*.go text eol=lf diff=golang
*.java text eol=lf diff=java
*.kt text eol=lf diff=kotlin
*.c text eol=lf diff=c
*.cpp text eol=lf diff=cpp
*.h text eol=lf diff=c
*.hpp text eol=lf diff=cpp
*.cs text eol=lf diff=csharp
*.php text eol=lf diff=php
*.rb text eol=lf diff=ruby
*.swift text eol=lf diff=swift
*.scala text eol=lf diff=scala

# ============================================
# Web files
# ============================================
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.sass text eol=lf diff=css
*.less text eol=lf diff=css
*.xml text eol=lf diff=xml
*.svg text eol=lf diff=xml
*.vue text eol=lf diff=vue
*.svelte text eol=lf diff=svelte

# ============================================
# Configuration files
# ============================================
*.json text eol=lf diff=json
*.yaml text eol=lf diff=yaml
*.yml text eol=lf diff=yaml
*.toml text eol=lf diff=toml
*.ini text eol=lf diff=ini
*.conf text eol=lf diff=conf
*.cfg text eol=lf diff=cfg
.env text eol=lf diff=env
*.env.* text eol=lf diff=env

# ============================================
# Documentation files
# ============================================
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.rst text eol=lf diff=restructuredtext
*.txt text eol=lf diff=plaintext
*.adoc text eol=lf diff=asciidoc
*.tex text eol=lf diff=tex

# ============================================
# Shell scripts
# ============================================
*.sh text eol=lf diff=shell
*.bash text eol=lf diff=shell
*.zsh text eol=lf diff=shell
*.fish text eol=lf diff=shell
Makefile text eol=lf diff=makefile
*.mk text eol=lf diff=makefile

# ============================================
# Binary files
# ============================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.tiff binary
*.svgz binary

*.mp3 binary
*.mp4 binary
*.wav binary
*.flac binary
*.ogg binary
*.aac binary
*.m4a binary
*.wma binary

*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
*.rar binary

*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary

*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# ============================================
# Git LFS - Large files
# ============================================
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.sketch filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text
*.ma filter=lfs diff=lfs merge=lfs -text

*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# ============================================
# Security files
# ============================================
*.gpg binary
*.pem binary
*.key binary
*.crt binary
*.p12 binary
*.pfx binary

# ============================================
# Database files
# ============================================
*.db binary
*.sqlite binary
*.sqlite3 binary

# ============================================
# Cache and build artifacts
# ============================================
node_modules/ linguist-generated=false
dist/ linguist-generated=false
build/ linguist-generated=false
target/ linguist-generated=false
*.min.js linguist-generated=false
*.min.css linguist-generated=false

# ============================================
# Vendor files
# ============================================
vendor/ linguist-vendored
bower_components/ linguist-vendored

# ============================================
# Test coverage
# ============================================
coverage/ linguist-generated=false
*.lcov linguist-generated=false
.nyc_output/ linguist-generated=false

# ============================================
# Lock files
# ============================================
package-lock.json merge=binary-lock-file
yarn.lock merge=binary-lock-file
pnpm-lock.yaml merge=binary-lock-file
Cargo.lock merge=binary-lock-file
go.sum merge=binary-lock-file